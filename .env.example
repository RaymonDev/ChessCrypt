# Lichess Bot API Personal Access Tokens
# Create two Lichess accounts with 0 games played:
#   1. RookCipherBot (White / Challenger)
#   2. PawnVaultBot  (Black / Acceptor)
# Generate tokens at https://lichess.org/account/oauth/token/create
# Required scopes: bot:play, challenge:read, challenge:write

LICHESS_WHITE_BOT_NAME=RookCipherBot
LICHESS_WHITE_BOT_TOKEN=lip_your_white_bot_token_here

LICHESS_BLACK_BOT_NAME=PawnVaultBot
LICHESS_BLACK_BOT_TOKEN=lip_your_black_bot_token_here

# Optional passphrase for symmetric encryption before move encoding
CHESSCRYPT_PASSPHRASE=
